# ── Deployment ───────────────────────────────────
DEPLOYMENT_MODE=standalone
DEFAULT_GROUP_ID=          # set AFTER running: npm run setup:standalone
APP_DOMAIN=                # https://finance.clientdomain.com
LICENSE_KEY=               # provided by XFinance team

# ── Database ─────────────────────────────────────
DB_NAME=xfinance
DB_USER=postgres
DB_PASSWORD=               # use a strong random password
DATABASE_URL=postgresql://postgres:YOURPASSWORD@postgres:5432/xfinance

# ── Redis ────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ── Auth ─────────────────────────────────────────
JWT_SECRET=                # generate: openssl rand -hex 32  (must be exactly 64 hex chars = 256 bits)
COOKIE_SECRET=             # REQUIRED — encrypts login sessions; generate: openssl rand -hex 32 (64 hex chars)
JWT_EXPIRY=7d

# ── Cloudinary (create a free account at cloudinary.com) ─
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email ────────────────────────────────────────
# Simplest for standalone: set up the client's own mail server in the app
# (Settings → Email → SMTP Configuration) — invoices, receipts, reminders and
# statements then go out from their own address and none of the below is needed
# for them. The platform mailer below (ZeptoMail) is still used for logins /
# password resets / payslips and for entities without their own SMTP.
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_API_KEY=
DEFAULT_EMAIL_FROM=        # e.g. noreply@clientdomain.com
DEFAULT_EMAIL_FROM_NAME=
SMTP_ENCRYPTION_KEY=       # optional; generate: openssl rand -hex 32 (else COOKIE_SECRET is used)

# ── Frontend ─────────────────────────────────────
FRONTEND_URL=              # https://finance.clientdomain.com
ALLOWED_DOMAIN=            # clientdomain.com
NEXT_PUBLIC_WS_URL=        # https://finance.clientdomain.com
ENABLE_REWRITE=false       # Nginx handles routing in production

# ── Node ─────────────────────────────────────────
NODE_ENV=production
