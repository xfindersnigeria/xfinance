<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: Arial, sans-serif; font-size: 10px; color: #333; background: #fff; }
.container { margin: 0 auto; padding: 20px 24px; }
.header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 3px solid var(--primary); padding-bottom: 12px; margin-bottom: 16px; }
.org { font-size: 13px; font-weight: 700; color: var(--primary); }
.title { font-size: 17px; font-weight: bold; color: #1e293b; margin-top: 2px; }
.subtitle { color: #64748b; font-size: 10px; margin-top: 3px; }
.summary { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 16px; }
.summary-box { flex: 1 1 140px; background: #f8fafc; border-radius: 6px; padding: 8px 10px; }
.summary-label { font-size: 9px; color: #94a3b8; margin-bottom: 3px; }
.summary-value { font-size: 12px; font-weight: 600; color: #1e293b; }
.section { margin-bottom: 16px; page-break-inside: auto; }
.section-title { font-size: 11px; font-weight: 700; color: #1e293b; margin-bottom: 6px; }
table { width: 100%; border-collapse: collapse; font-size: 9.5px; }
thead { display: table-header-group; }
thead tr { background: #f1f5f9; }
th { padding: 6px 7px; text-align: left; font-size: 9px; color: #64748b; font-weight: 600; }
td { padding: 5px 7px; border-bottom: 1px solid #e2e8f0; vertical-align: top; }
tr { page-break-inside: avoid; }
.num { text-align: right; white-space: nowrap; }
.row-header td { font-weight: 700; color: #1e293b; background: #fafafa; }
.row-subtotal td { font-weight: 600; border-top: 1px solid #cbd5e1; }
.row-total td { font-weight: 700; background: #f8fafc; border-top: 2px solid #cbd5e1; color: #1e293b; }
.notes { margin-top: 10px; font-size: 9px; color: #64748b; }
.notes p { margin-bottom: 3px; }
.warning { background: #fffbeb; border: 1px solid #fde68a; color: #92400e; border-radius: 6px; padding: 8px 10px; margin-bottom: 14px; font-size: 9.5px; }
.footer { text-align: center; margin-top: 16px; font-size: 8.5px; color: #94a3b8; border-top: 1px solid #e2e8f0; padding-top: 8px; }
</style>

<div class="container">
  <div class="header">
    <div style="display:flex;align-items:flex-start;gap:10px;">
      {{#if entity.logo.base64}}
        <img src="{{entity.logo.base64}}" alt="Logo" style="height:40px;width:40px;object-fit:contain;border-radius:6px;" />
      {{/if}}
      <div>
        {{#if entity.name}}<div class="org">{{entity.name}}</div>{{/if}}
        <div class="title">{{report.title}}</div>
        {{#if report.period}}<div class="subtitle">{{report.period}}</div>{{/if}}
        {{#if report.currencyNote}}<div class="subtitle">{{report.currencyNote}}</div>{{/if}}
      </div>
    </div>
    <div style="text-align:right">
      <div class="subtitle">Generated: {{formatDate generatedAt}}</div>
    </div>
  </div>

  {{#each report.warnings}}
    <div class="warning">{{this}}</div>
  {{/each}}

  {{#if report.summary.length}}
  <div class="summary">
    {{#each report.summary}}
      <div class="summary-box"><div class="summary-label">{{label}}</div><div class="summary-value">{{value}}</div></div>
    {{/each}}
  </div>
  {{/if}}

  {{#each report.sections}}
  <div class="section">
    {{#if title}}<div class="section-title">{{title}}</div>{{/if}}
    <table>
      <thead>
        <tr>
          {{#each columns}}<th class="{{#if right}}num{{/if}}">{{label}}</th>{{/each}}
        </tr>
      </thead>
      <tbody>
        {{#each rows}}
        <tr class="row-{{kind}}">
          {{#each cells}}
            <td class="{{#if right}}num{{/if}}" {{#if indent}}style="padding-left:{{indent}}px"{{/if}}>{{text}}</td>
          {{/each}}
        </tr>
        {{/each}}
        {{#unless rows.length}}
        <tr><td colspan="{{columns.length}}" style="text-align:center;color:#94a3b8;padding:14px;">No data for this period</td></tr>
        {{/unless}}
      </tbody>
    </table>
  </div>
  {{/each}}

  {{#if report.notes.length}}
  <div class="notes">
    {{#each report.notes}}<p>{{this}}</p>{{/each}}
  </div>
  {{/if}}

  <div class="footer">System generated report</div>
</div>
